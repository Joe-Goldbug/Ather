{
  "name": "@eva/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "bun run --cwd ../../packages/core build && nest build",
    "start": "nest start",
    "start:prod": "node dist/main.js",
    "test": "bun run test:spec && bun run test:unit",
    "test:spec": "jest",
    "test:unit": "vitest run",
    "test:pg": "vitest run --include '**/*.pg.test.ts'",
    "worker": "node dist/queue/worker.js"
  },
  "dependencies": {
    "@eva/core": "workspace:*",
    "@neondatabase/serverless": "^1.0.2",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.7",
    "bullmq": "^5.34.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "ioredis": "^5.6.1",
    "pg": "^8.16.0",
    "react": "19.3.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.12.2",
    "rxjs": "^7.8.1",
    "viem": "^2.57.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "10.4.22",
    "@types/cookie-parser": "^1.4.10",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  }
}
