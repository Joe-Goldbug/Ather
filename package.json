{
  "name": "eva-web3",
  "version": "0.1.0",
  "private": true,
  "author": "Ethan & Whitepeace",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24.21.0",
    "bun": ">=1.3.14"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:core": "cd packages/core && bun run build",
    "build:api": "cd apps/api && bun run build",
    "build:web": "cd apps/web && NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL:-http://127.0.0.1:3101} bun run build",
    "build": "bun run build:core && bun run build:api && bun run build:web",
    "dev:api": "cd apps/api && bun run dev",
    "dev:web": "cd apps/web && bun run dev",
    "test:core": "bun test packages/core/src",
    "test:api": "cd apps/api && bun run test",
    "test:web": "cd apps/web && bun run test",
    "test": "bun run test:core && bun run test:api",
    "test:e2e": "node e2e-test.mjs"
  },
  "devDependencies": {
    "dotenv": "^17.4.0",
    "playwright": "^1.59.1",
    "typescript": "^5.9.3"
  }
}
