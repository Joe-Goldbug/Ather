# Eva-web3 Environment Configuration
# Anonymous assessment service runs without a database.
# Only needed in production, to sign the claim token.
GUEST_CLAIM_SECRET=change-me-in-production

# API
PORT=3001
NODE_ENV=development

# Web (SSR API base)
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001
FRONTEND_URL=http://localhost:3000

# Bounded "Understand with Eva" conversations. Keep disabled until the
# migration and runtime verification have completed; a comma-separated pilot
# user list can enable either entry point without opening it to everyone.
EVA_RESULT_FOLLOWUP_V1=false
EVA_HOME_CHAT_V1=false
EVA_RESULT_FOLLOWUP_PILOT_USER_IDS=
EVA_HOME_CHAT_PILOT_USER_IDS=
